{
  "id": "badge",
  "name": "Badge",
  "storyTitle": "Components/Badge",
  "overview": "Compact status or metadata chip. Soft vs strong emphasis; optional dot, count, or icon.",
  "whenToUse": [
    "Status labels",
    "Counts on tabs/nav",
    "Non-interactive metadata"
  ],
  "variants": {
    "role": [
      "neutral",
      "info",
      "success",
      "warning",
      "danger",
      "ai"
    ],
    "emphasis": [
      "soft",
      "strong"
    ],
    "size": [
      "sm",
      "md",
      "lg"
    ],
    "state": [
      "default",
      "disabled"
    ]
  },
  "anatomy": [
    "Root",
    "Optional dot",
    "Optional icon",
    "Label",
    "Optional count"
  ],
