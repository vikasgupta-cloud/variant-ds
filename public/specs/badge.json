  "props": [
    {
      "name": "role",
      "type": "neutral | info | success | warning | danger | ai",
      "default": "neutral",
      "description": "Status colour."
    },
    {
      "name": "emphasis",
      "type": "soft | strong",
      "default": "soft",
      "description": "Fill weight."
    },
    {
      "name": "size",
      "type": "sm | md | lg",
      "default": "md",
      "description": "Chip size."
    },
    {
      "name": "dot",
      "type": "boolean",
      "default": "false",
      "description": "Leading status dot."
    },
    {
      "name": "count",
      "type": "number | string",
      "description": "Trailing count pill."
    }
  ],
  "accessibility": [
    "Decorative dots are aria-hidden",
    "Prefer text content that names the status"
  ],
  "do": [
    "Use soft for inline metadata",
    "Use strong sparingly for high emphasis"
  ],
  "dont": [
    "Don't make badges the only affordance for a critical action"
  ]
}
