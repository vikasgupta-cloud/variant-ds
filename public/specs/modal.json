{
  "id": "modal",
  "name": "Modal",
  "storyTitle": "Components/Modal",
  "overview": "Dialog with Overlay scrim and z/modal stacking. Panel is surface-raised so nested Cards resolve correctly.",
  "whenToUse": [
    "Confirmations",
    "Focused forms",
    "Destructive confirms"
  ],
  "variants": {
    "size": [
      "sm",
      "md",
      "lg"
    ],
    "state": [
      "default"
    ]
  },
  "anatomy": [
    "Trigger",
    "Overlay (scrim)",
    "Content panel",
    "Title",
    "Description",
    "Body",
    "Footer",
    "Close"
  ],
  "tokens": {
    "role": [
      {
        "path": "bg/surface-raised",
        "cssVar": "--bg-surface-raised"
      },
      {
        "path": "text/primary",
        "cssVar": "--text-primary"
      },
      {
        "path": "text/secondary",
        "cssVar": "--text-secondary"
      },
      {
        "path": "border/subtle",
        "cssVar": "--border-subtle"
      },
      {
        "path": "border/focus",
        "cssVar": "--border-focus"
      },
      {
        "path": "icon/secondary",
        "cssVar": "--icon-secondary"
      },
      {
        "path": "icon/primary",
        "cssVar": "--icon-primary"
      }
    ],
    "surface": [
      {
        "path": "surface/level-1",
        "cssVar": "--surface-level-1"
      }
    ],
    "structure": [
