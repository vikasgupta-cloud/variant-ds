  "props": [
    {
      "name": "size",
      "type": "sm | md | lg",
      "default": "md",
      "description": "Max width token."
    },
    {
      "name": "title",
      "type": "string",
      "description": "Dialog title (required)."
    },
    {
      "name": "open",
      "type": "boolean",
      "description": "Controlled open state."
    },
    {
      "name": "trigger",
      "type": "ReactNode",
      "description": "Element that opens the dialog."
    },
    {
      "name": "footer",
      "type": "ReactNode",
      "description": "Action row."
    }
  ],
  "accessibility": [
    "dialog role from Radix",
    "Focus trapped while open",
    "Escape closes",
    "Title required for accessible name"
  ],
  "do": [
    "Put destructive confirms in the footer with primary destructive",
    "Nest Card inside for complex content"
  ],
  "dont": [
    "Don't skip the title",
    "Don't use Modal for non-blocking inline messages — use Alert"
  ]
