        "cssVar": "--shadow-sm"
      },
      {
        "path": "layout/stack",
        "cssVar": "--layout-stack"
      },
      {
        "path": "layout/stack-tight",
        "cssVar": "--layout-stack-tight"
      },
      {
        "path": "z/modal",
        "cssVar": "--z-modal"
      },
      {
