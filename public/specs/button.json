  "props": [
    {
      "name": "hierarchy",
      "type": "primary | secondary | tertiary | ghost | link",
      "default": "primary",
      "description": "Visual weight / chrome style."
    },
    {
      "name": "color",
      "type": "depends on hierarchy (type-safe)",
      "default": "default",
      "description": "Semantic colour. Primary only allows default | destructive | ai."
    },
    {
      "name": "size",
      "type": "xs | sm | md | lg",
      "default": "md",
      "description": "Control sizing from Structure."
    },
    {
      "name": "icon",
      "type": "none | leading | trailing | only",
      "default": "none",
      "description": "Icon placement axis."
    },
    {
      "name": "state",
      "type": "default | hover | active | focused | disabled",
      "default": "default",
      "description": "Design-review only — not for production."
    },
    {
      "name": "loading",
      "type": "boolean",
      "default": "false",
      "description": "Shows spinner and sets aria-busy."
    }
  ],
  "accessibility": [
    "Native button semantics; fully keyboard operable",
    "Visible focus ring via focus-visible + border/focus",
    "loading sets aria-busy; disabled via disabled / aria-disabled",
    "icon-only requires aria-label",
    "Respects prefers-reduced-motion on transitions/spinner"
  ],
  "do": [
    "Use primary default for the main action on a view",
    "Pair Alert actions as ghost + secondary coloured by role",
    "Leave state at default in product code"
  ],
  "dont": [
    "Don't use primary + warning/success/info (blocked at the type level)",
    "Don't put a primary default button inside a coloured Alert",
    "Don't use brand yellow as a primary button fill"
  ]
}
