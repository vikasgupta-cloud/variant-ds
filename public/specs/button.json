{
  "id": "button",
  "name": "Button",
  "storyTitle": "Components/Button",
  "overview": "Primary interactive control. Hierarchy and colour are independent axes with type-safe allowed pairs. Primary uses bg/neutral/strong — not brand yellow (yellow is for wayfinding/selection).",
  "whenToUse": [
    "Trigger actions (submit, confirm, navigate)",
    "Use hierarchy to express emphasis; colour for semantic meaning (destructive, AI, status on secondary/ghost/link)",
    "Prefer link hierarchy for inline textual actions"
  ],
  "variants": {
    "hierarchy": [
      "primary",
      "secondary",
      "tertiary",
      "ghost",
      "link"
    ],
    "color": [
      "default",
      "destructive",
      "warning",
      "success",
      "info",
      "ai"
    ],
    "size": [
      "xs",
      "sm",
      "md",
      "lg"
    ],
    "icon": [
      "none",
      "leading",
      "trailing",
      "only"
    ],
    "state": [
      "default",
      "hover",
      "active",
      "focused",
      "disabled"
    ]
  },
  "anatomy": [
    "Root (button)",
    "Leading/trailing icon",
    "Label",
    "Loading spinner"
  ],
