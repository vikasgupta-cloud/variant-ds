{
  "name": "@wingify/variant-ds",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "VWO (Wingify) design system — React component library and documented reference",
  "scripts": {
    "tokens:build": "node build/style-dictionary.config.js",
    "specs:build": "node --experimental-strip-types scripts/generate-specs.ts",
